<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="650.0" style="-fx-background-color: #64DFDF;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutorapplication.Gui.ConfirmBookingGui">

    <VBox alignment="CENTER" layoutX="100.0" layoutY="40.0" prefWidth="450.0" spacing="20.0" style="-fx-background-color: white; -fx-background-radius: 10px; -fx-padding: 25px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 5);">
        <VBox alignment="CENTER" spacing="5.0">
            <Label style="-fx-font-weight: bold; -fx-font-size: 22px; -fx-text-fill: #1D4ED8;" text="Booking Summary"/>
            <Label style="-fx-font-size: 13px; -fx-text-fill: blue;" text="Please review lesson details before confirming"/>
        </VBox>

        <GridPane hgap="15.0" vgap="10.0" alignment="CENTER">
            <Label style="-fx-font-weight: bold;" text="Lesson ID:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="idLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label style="-fx-font-weight: bold;" text="Subject:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="subjectLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label style="-fx-font-weight: bold;" text="Day:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="dayLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label style="-fx-font-weight: bold;" text="Time Slot:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label fx:id="timeLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label style="-fx-font-weight: bold;" text="Price:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label fx:id="priceLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="4"/>

            <Label style="-fx-font-weight: bold;" text="Tutor Email:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Label fx:id="tutorLabel" text="-" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
        </GridPane>

        <HBox alignment="CENTER" spacing="20.0">
            <Button fx:id="cancelButton" onAction="#cancel" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" text="Cancel"/>
            <Button fx:id="confirmButton" onAction="#confirmBooking" prefHeight="35.0" prefWidth="160.0" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" text="Confirm Booking"/>
        </HBox>
    </VBox>
</AnchorPane>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="550.0" prefWidth="950.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutorapplication.gui.ConfirmBookingTutorGui">

    <ImageView fitHeight="550.0" fitWidth="950.0" pickOnBounds="true">
        <Image url="@../images/tutorhomepage.png"/>
    </ImageView>

    <HBox layoutX="20.0" layoutY="25.0" prefHeight="500.0" prefWidth="910.0" spacing="20.0">

        <VBox alignment="CENTER" prefHeight="500.0" prefWidth="240.0" spacing="20.0" style="-fx-background-color: rgba(255, 255, 255, 0.9); -fx-background-radius: 10px; -fx-padding: 20px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.25), 10, 0, 0, 0);">

            <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../images/books.png"/>
            </ImageView>

            <VBox alignment="CENTER" spacing="5.0">
                <Label alignment="CENTER" text="Approvals" textAlignment="CENTER" style="-fx-font-weight: bold; -fx-font-family: 'System'; -fx-font-size: 22px; -fx-text-fill: #1D4ED8;"/>
                <Label alignment="CENTER" text="Select a request to&#10;accept or reject it." textAlignment="CENTER" style="-fx-font-size: 12px; -fx-text-fill: blue;"/>
            </VBox>

            <VBox fx:id="decisionBox" alignment="CENTER" spacing="12.0" visible="false" managed="false">
                <Button onAction="#accept" prefHeight="38.0" prefWidth="180.0" style="-fx-background-color: #16A34A; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" text="Accept Booking"/>
                <Button onAction="#reject" prefHeight="38.0" prefWidth="180.0" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 5px;" text="Reject Booking"/>
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
            </VBox>

            <VBox prefHeight="50.0" VBox.vgrow="ALWAYS"/>

            <Button fx:id="backButton" onAction="#goBack" prefHeight="35.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: blue; -fx-font-weight: bold; -fx-underline: true; -fx-cursor: hand;" text="Return to Home Tutor"/>
        </VBox>

        <TableView fx:id="requestsTable" prefHeight="500.0" prefWidth="650.0" HBox.hgrow="ALWAYS" style="-fx-background-radius: 5px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 10, 0, 0, 5); -fx-background-color: rgba(255,255,255,0.85);">
            <columns>
                <TableColumn fx:id="colBookingId" prefWidth="90.0" text="Reservation ID"/>
                <TableColumn fx:id="colStudent" prefWidth="160.0" text="Student"/>
                <TableColumn fx:id="colSubject" prefWidth="110.0" text="Subject"/>
                <TableColumn fx:id="colDay" prefWidth="95.0" text="Day"/>
                <TableColumn fx:id="colTime" prefWidth="90.0" text="Time"/>
                <TableColumn fx:id="colStatus" prefWidth="85.0" text="Actual State"/>
            </columns>
        </TableView>
    </HBox>
</AnchorPane>

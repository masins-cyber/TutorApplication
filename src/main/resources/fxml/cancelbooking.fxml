<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tutorapplication.gui.CancelBookingGui">

    <ImageView fitHeight="600.0" fitWidth="800.0" pickOnBounds="true">
        <Image url="@../images/books2.png"/>
    </ImageView>

    <AnchorPane layoutX="440.0" prefHeight="600.0" prefWidth="360.0" style="-fx-background-color: rgba(255, 255, 255, 0.5); -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.15), 20, 0, -2, 0); -fx-backdrop-filter: blur(15px);">

        <VBox alignment="CENTER" layoutX="25.0" layoutY="30.0" prefWidth="310.0" spacing="15.0">

            <Label style="-fx-font-weight: bold; -fx-font-family: 'System'; -fx-font-size: 22px; -fx-text-fill: #DC2626;" text="Cancel Reservation"/>

            <ImageView fitHeight="45.0" fitWidth="45.0" pickOnBounds="true" preserveRatio="true">
                <Image url="@../images/hat.png"/>
            </ImageView>

            <Label style="-fx-font-size: 13px; -fx-text-fill: blue; -fx-font-weight: bold;" text="Are you sure to delete this booking?"/>

            <VBox spacing="8.0" style="-fx-background-color: white; -fx-padding: 15px; -fx-background-radius: 6px; -fx-border-color: #D1D5DB; -fx-border-radius: 6px;">

                <HBox spacing="5.0">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: black;" text="Reservation ID:"/>
                    <Label fx:id="bookingIdLabel" style="-fx-text-fill: black;" text="#0"/>
                </HBox>

                <HBox spacing="5.0">
                    <Label style="-fx-font-weight: bold; -fx-font-fill: blue;" text="Subject:"/>
                    <Label fx:id="subjectLabel" style="-fx-text-fill: black;" text="N/A"/>
                </HBox>

                <HBox spacing="5.0">
                    <Label style="-fx-font-weight: bold; -fx-font-fill: blue;" text="Tutor:"/>
                    <Label fx:id="tutorLabel" style="-fx-text-fill: black;" text="N/A"/>
                </HBox>

                <HBox spacing="5.0">
                    <Label style="-fx-font-weight: bold; -fx-font-fill: blue;" text="Day:"/>
                    <Label fx:id="dayLabel" style="-fx-text-fill: black;" text="N/A"/>
                </HBox>

                <HBox spacing="5.0">
                    <Label style="-fx-font-weight: bold; -fx-font-fill: blue;" text="Time:"/>
                    <Label fx:id="timeLabel" style="-fx-text-fill: black;" text="N/A"/>
                </HBox>

                <HBox spacing="5.0">
                    <Label style="-fx-font-weight: bold; -fx-font-fill: blue;" text="Actual State:"/>
                    <Label fx:id="statusLabel" style="-fx-text-fill: black;" text="N/A"/>
                </HBox>

            </VBox>

            <Button onAction="#confirmCancellation" prefHeight="40.0" prefWidth="310.0" style="-fx-background-color: #DC2626; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 5px; -fx-cursor: hand;" text="CONFIRM CANCELLATION">
                <VBox.margin>
                    <Insets top="10.0"/>
                </VBox.margin>
            </Button>

            <Button fx:id="abortButton" onAction="#abort" prefHeight="30.0" prefWidth="180.0" style="-fx-background-color: transparent; -fx-text-fill: #1D4ED8; -fx-font-weight: bold; -fx-underline: true; -fx-cursor: hand;" text="Back to My Bookings"/>

        </VBox>
    </AnchorPane>
</AnchorPane>

